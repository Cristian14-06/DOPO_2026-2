@startuml Seq_01_SlotMachine_Constructor_Default
title 1. Constructor SlotMachine()
skinparam shadowing false
autonumber

actor Usuario
participant SlotMachine
participant BodyMachine
participant Rectangle

Usuario -> SlotMachine: <<create>> new SlotMachine()
activate SlotMachine

create BodyMachine
SlotMachine -> BodyMachine: <<create>> new BodyMachine()
activate BodyMachine

create Rectangle
BodyMachine -> Rectangle: <<create>> new Rectangle()
activate Rectangle
Rectangle --> BodyMachine: body
deactivate Rectangle

BodyMachine --> SlotMachine: principal_body
deactivate BodyMachine

SlotMachine --> Usuario: machine
deactivate SlotMachine
@enduml

@startuml Seq_02_SlotMachine_Constructor_N
title 2. Constructor SlotMachine(int n)
skinparam shadowing false
autonumber

actor Usuario
participant SlotMachine
participant BodyMachine
participant Rectangle

Usuario -> SlotMachine: <<create>> new SlotMachine(n)
activate SlotMachine

opt n >= 1 && n <= 5
    create BodyMachine
    SlotMachine -> BodyMachine: <<create>> new BodyMachine()
    activate BodyMachine

    create Rectangle
    BodyMachine -> Rectangle: <<create>> new Rectangle()
    activate Rectangle
    Rectangle --> BodyMachine: body
    deactivate Rectangle

    BodyMachine --> SlotMachine: principal_body
    deactivate BodyMachine

    loop i = 0 to n - 1
        SlotMachine -> SlotMachine: addWheel(i + 1)
        activate SlotMachine
        SlotMachine --> SlotMachine: void
        deactivate SlotMachine

        SlotMachine -> SlotMachine: addSymbol(i + 1, colors[i])
        activate SlotMachine
        SlotMachine --> SlotMachine: void
        deactivate SlotMachine
    end

    SlotMachine -> SlotMachine: spin()
    activate SlotMachine
    SlotMachine --> SlotMachine: void
    deactivate SlotMachine
end

SlotMachine --> Usuario: machine
deactivate SlotMachine
@enduml

