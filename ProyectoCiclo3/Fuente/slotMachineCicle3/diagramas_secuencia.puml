Usuario -> SlotMachine: spin(wheel, steps)
activate SlotMachine

opt !wheels.isEmpty() && wheel >= 1 && wheel <= wheels.size()
    SlotMachine -> Wheel: wheels.get(wheel - 1).spin(steps)
    activate Wheel
    opt !lock && !symbols.isEmpty()
        Wheel -> Wheel: refresh()
        activate Wheel
        opt visible
            Wheel -> Wheel: showSymbol(shownSymbol)
