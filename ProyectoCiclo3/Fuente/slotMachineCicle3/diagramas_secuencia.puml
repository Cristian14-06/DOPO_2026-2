actor Usuario
participant SlotMachine
participant BodyMachine
participant Wheel
participant Symbol
participant Rectangle
participant Canvas

Usuario -> SlotMachine: isJackpot()
activate SlotMachine

alt wheels.size() == 0
    SlotMachine -> BodyMachine: body.get(0).normalColor()
    activate BodyMachine
    BodyMachine -> Rectangle: body.changeColor("blue")
    activate Rectangle
    Rectangle -> Canvas: canvas.draw(this, color, shape)
    Canvas --> Rectangle: void
    Rectangle --> BodyMachine: void
    deactivate Rectangle
    BodyMachine --> SlotMachine: void
    deactivate BodyMachine
    SlotMachine --> Usuario: false
else
    SlotMachine -> Wheel: wheels.get(0).getShownSymbol()
    activate Wheel
    Wheel --> SlotMachine: firstSymbol
    deactivate Wheel

    opt firstSymbol == null
        SlotMachine -> BodyMachine: body.get(0).normalColor()
        activate BodyMachine
        BodyMachine -> Rectangle: body.changeColor("blue")
        activate Rectangle
        Rectangle -> Canvas: canvas.draw(this, color, shape)
        Canvas --> Rectangle: void
        Rectangle --> BodyMachine: void
        deactivate Rectangle
        BodyMachine --> SlotMachine: void
        deactivate BodyMachine
        SlotMachine --> Usuario: false
    end

    loop i = 1 to wheels.size() - 1
        SlotMachine -> Wheel: wheels.get(i).getShownSymbol()
        activate Wheel
        Wheel --> SlotMachine: currentSymbol
        deactivate Wheel

        SlotMachine -> Symbol: currentSymbol.getColor()
        activate Symbol
        Symbol --> SlotMachine: currentColor
        deactivate Symbol

        SlotMachine -> Symbol: firstSymbol.getColor()
        activate Symbol
        Symbol --> SlotMachine: firstColor
        deactivate Symbol

        opt !currentColor.equals(firstColor)
            SlotMachine -> BodyMachine: body.get(0).normalColor()
            activate BodyMachine
            BodyMachine -> Rectangle: body.changeColor("blue")
            activate Rectangle
            Rectangle -> Canvas: canvas.draw(this, color, shape)
            Canvas --> Rectangle: void
            Rectangle --> BodyMachine: void
            deactivate Rectangle
            BodyMachine --> SlotMachine: void
            deactivate BodyMachine
            SlotMachine --> Usuario: false
        end
    end

    SlotMachine -> BodyMachine: body.get(0).changeColor()
    activate BodyMachine
    BodyMachine -> Rectangle: body.changeColor("yellow")
    activate Rectangle
    Rectangle -> Canvas: canvas.draw(this, color, shape)
    Canvas --> Rectangle: void
    Rectangle --> BodyMachine: void
    deactivate Rectangle
    BodyMachine --> SlotMachine: void
    deactivate BodyMachine
    SlotMachine --> Usuario: true
end
deactivate SlotMachine
